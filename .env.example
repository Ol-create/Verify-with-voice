# Copy to .env and fill in real values. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=truevoice
DB_USER=postgres
DB_PASS=change-me

# --- Tokens (use two different random values) ---
JWT_SECRET=change-me
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Admin dashboard (ADMIN_JWT_SECRET: a third, different random value) ---
ADMIN_JWT_SECRET=change-me
ADMIN_TOKEN_EXPIRE_MINUTES=480
ADMIN_LOGIN_RATE_LIMIT=5/minute

# --- Rate limiting, per company (falls back to per IP) ---
RATE_LIMIT=60/minute

# --- Logging: DEBUG, INFO, WARNING, ERROR ---
LOG_LEVEL=INFO

# --- Voice checks (defaults shown) ---
CHALLENGE_TTL=120
MATCH_THRESHOLD=0.8
SPOOF_THRESHOLD=0.30
SIMILARITY_THRESHOLD=0.65

# --- External services ---
OPENAI_API_KEY=sk-change-me
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
S3_BUCKET_NAME=change-me
AWS_REGION=us-east-1

# --- Optional: Supabase client (not used by the API yet) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Only needed once, while running the API-key hashing migration (b7c1d2e3f4a5) ---
FERNET_KEY=
